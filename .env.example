# Initial organisation name shown during first-run setup. Saved in the database.
ORG_NAME=Your Church

# Optional: path to the local app data directory. Defaults to ./data.
CHECKIN_DATA=./data

# Set to 1 to disable USB printer discovery, for development or tests.
CHECKIN_NO_USB=0

# Maintenance overrides. Leave unset for normal upgrades and restores.
# CHECKIN_UPGRADE_WITHOUT_BACKUP=1
# CHECKIN_RESTORE_WITHOUT_BACKUP=1
